# Sígale frontend (Vite) — copy to .env and adjust per environment.
# Only VITE_-prefixed vars are exposed to the client bundle.

# Base URL of the Sígale Express backend.
# Local dev:   http://localhost:25060
# Production:  https://coffeserver.onrender.com  (shared BlackCoffe server)
VITE_API_URL=http://localhost:25060
