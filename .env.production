# Sígale frontend (Vite) — PRODUCTION build.
#
# Loaded automatically by Vite when `npm run build` runs in production mode
# (the default for `vite build`). Overrides .env, but is overridden by
# .env.production.local (git-ignored — use for ephemeral overrides).
#
# Only VITE_-prefixed vars are exposed to the client bundle.

# Shared BlackCoffe backend. Sígale's API client prefixes every path with
# "/api/...", so requests land on the Sígale routes that BlackCoffe mounts via
# server/integration.js → mountSigale(app). See server/README.md → Deploy.
VITE_API_URL=https://coffeserver.onrender.com
