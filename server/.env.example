# Sígale backend — copy to server/.env and fill in. NEVER commit real secrets.
# server/.env is git-ignored.

# ── Server ──────────────────────────────────────────────────
PORT=25060

# ── Database (DEDICATED `sigale` DB ONLY) ───────────────────
# GUARDRAIL: DB_NAME must be 'sigale'. db.js refuses to connect otherwise.
# Same DigitalOcean cluster/host as BlackCoffe, different database.
DB_HOST=
DB_PORT=25060
DB_USER=
DB_PASSWORD=
DB_NAME=sigale

# Path to the downloaded DigitalOcean CA certificate (SSL verification, ADR §9).
# rejectUnauthorized stays at its secure default — do NOT disable it.
DB_CA_CERT=./certs/ca-certificate.crt

# ── Error notifier (Resend) ─────────────────────────────────
RESEND_API_KEY=
NOTIFICATION_EMAIL=
FROM_EMAIL=onboarding@resend.dev

# ── Initial organizer seed (node seed/seedOrganizer.js) ─────
# Use a FRESHLY ROTATED password — never the leaked plaintext from ADR-0001.
ORGANIZER_USERNAME=David
ORGANIZER_INITIAL_PASSWORD=
